-- =============================================================
-- 16. BUSINESS QUESTION:
-- HOW ARE PATIENT VISITS DISTRIBUTED ACROSS DEPARTMENTS?
-- =============================================================

SELECT
    department_referral,
    COUNT(*) AS patient_volume,

    ROUND(
        100.0
        * COUNT(*)
        / SUM(COUNT(*)) OVER (),
        2
    ) AS percent_of_total_visits,

    SUM(admission_status = 'Admitted')
