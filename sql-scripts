-- =============================================================
-- 17. ADMISSION STATUS DISTRIBUTION
-- =============================================================

SELECT
    admission_status,
    COUNT(*) AS patient_volume,

    ROUND(
        100.0
        * COUNT(*)
        / SUM(COUNT(*)) OVER (),
        2
    ) AS percent_of_total_visits

FROM patient_flow_clean

GROUP BY admission_status

ORDER BY patient_volume DESC;


-- =============================================================
-- 18. DEPARTMENT PERFORMANCE COMPARISON
-- =============================================================

WITH department_performance AS (
    SELECT
        department_referral,

        COUNT(*) AS patient_volume,

        AVG(wait_time_minutes)
            AS average_wait_time_minutes,

        AVG(satisfaction_score)
            AS average_satisfaction_score,

        100.0
        * SUM(admission_status = 'Admitted')
        / COUNT(*) AS admission_rate_percent

    FROM patient_flow_clean

    GROUP BY department_referral
)

SELECT
    department_referral,
    patient_volume,

    ROUND(
        average_wait_time_minutes,
        2
    ) AS average_wait_time_minutes,

    ROUND(
        average_satisfaction_score,
        2
    ) AS average_satisfaction_score,

    ROUND(
        admission_rate_percent,
        2
    ) AS admission_rate_percent,

    DENSE_RANK() OVER (
        ORDER BY patient_volume DESC
    ) AS patient_volume_rank,

    DENSE_RANK() OVER (
        ORDER BY average_wait_time_minutes ASC
    ) AS wait_time_performance_rank,

    DENSE_RANK() OVER (
        ORDER BY average_satisfaction_score DESC
    ) AS satisfaction_rank

FROM department_performance

ORDER BY patient_volume_rank;


-- =============================================================
-- 19. MONTHLY PATIENT-FLOW TRENDS
-- =============================================================

SELECT
    DATE_FORMAT(
        admission_date,
        '%Y-%m'
    ) AS admission_month,

    COUNT(*) AS patient_volume,

    SUM(admission_status = 'Admitted')
        AS admitted_patient_visits,

    ROUND(
        AVG(wait_time_minutes),
        2
    ) AS average_wait_time_minutes,

    ROUND(
        AVG(satisfaction_score),
        2
    ) AS average_satisfaction_score

FROM patient_flow_clean

GROUP BY DATE_FORMAT(
    admission_date,
    '%Y-%m'
)

ORDER BY admission_month;


-- =============================================================
-- 20. MONTH-OVER-MONTH PATIENT-VOLUME CHANGE
-- =============================================================

WITH monthly_patient_volume AS (
    SELECT
        DATE_FORMAT(
            admission_date,
            '%Y-%m'
        ) AS admission_month,

        COUNT(*) AS patient_volume

    FROM patient_flow_clean

    GROUP BY DATE_FORMAT(
        admission_date,
        '%Y-%m'
    )
),

monthly_comparison AS (
    SELECT
        admission_month,
        patient_volume,

        LAG(patient_volume) OVER (
            ORDER BY admission_month
        ) AS previous_month_volume

    FROM monthly_patient_volume
)

SELECT
    admission_month,
    patient_volume,
    previous_month_volume,

    patient_volume
    - previous_month_volume
        AS volume_change,

    ROUND(
        100.0
        * (
            patient_volume
            - previous_month_volume
        )
        / NULLIF(previous_month_volume, 0),
        2
    ) AS month_over_month_change_percent

FROM monthly_comparison

ORDER BY admission_month;


-- =============================================================
-- 21. IDENTIFY HIGH-VOLUME, HIGH-WAIT DEPARTMENTS
-- =============================================================
-- Departments with above-average volume and above-average wait
-- times may require additional staffing or workflow improvements.

WITH department_metrics AS (
    SELECT
        department_referral,

        COUNT(*) AS patient_volume,

        AVG(wait_time_minutes)
            AS average_wait_time_minutes,

        AVG(satisfaction_score)
            AS average_satisfaction_score

    FROM patient_flow_clean

    GROUP BY department_referral
),

department_benchmarks AS (
    SELECT
        AVG(patient_volume)
            AS average_department_volume,

        AVG(average_wait_time_minutes)
            AS average_department_wait_time

    FROM department_metrics
)

SELECT
    department_metrics.department_referral,
    department_metrics.patient_volume,

    ROUND(
        department_metrics.average_wait_time_minutes,
        2
    ) AS average_wait_time_minutes,

    ROUND(
        department_metrics.average_satisfaction_score,
        2
    ) AS average_satisfaction_score,

    CASE
        WHEN
            department_metrics.patient_volume
                > department_benchmarks.average_department_volume

            AND

            department_metrics.average_wait_time_minutes
                > department_benchmarks.average_department_wait_time

            THEN 'High Priority'

        WHEN
            department_metrics.patient_volume
                > department_benchmarks.average_department_volume

            THEN 'Monitor Patient Volume'

        WHEN
            department_metrics.average_wait_time_minutes
                > department_benchmarks.average_department_wait_time

            THEN 'Monitor Wait Time'

        ELSE 'Standard Priority'
    END AS operational_priority

FROM department_metrics

CROSS JOIN department_benchmarks

ORDER BY
    CASE
        WHEN
            department_metrics.patient_volume
                > department_benchmarks.average_department_volume

            AND

            department_metrics.average_wait_time_minutes
                > department_benchmarks.average_department_wait_time

            THEN 1

        WHEN
            department_metrics.patient_volume
                > department_benchmarks.average_department_volume

            THEN 2

        WHEN
            department_metrics.average_wait_time_minutes
                > department_benchmarks.average_department_wait_time

            THEN 3

        ELSE 4
    END,

    department_metrics.patient_volume DESC;


-- =============================================================
-- 22. CREATE REUSABLE DEPARTMENT KPI VIEW
-- =============================================================

CREATE OR REPLACE VIEW department_kpi_summary AS

SELECT
    department_referral,

    COUNT(*) AS patient_volume,

    ROUND(
        AVG(wait_time_minutes),
        2
    ) AS average_wait_time_minutes,

    ROUND(
        AVG(satisfaction_score),
        2
    ) AS average_satisfaction_score,

    COUNT(satisfaction_score)
        AS completed_satisfaction_surveys,

    ROUND(
        100.0
        * SUM(admission_status = 'Admitted')
        / COUNT(*),
        2
    ) AS admission_rate_percent

FROM patient_flow_clean

GROUP BY department_referral;


