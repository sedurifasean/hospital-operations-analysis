/*
===============================================================================
PROJECT: Hospital Operations & Patient Flow Analysis
SQL DIALECT: MySQL 8.0+

OBJECTIVE:
Clean and analyze hospital patient-flow data to identify trends in admissions,
wait times, patient satisfaction, demographics, and department performance.

WORKFLOW:
1. Create database and raw table
2. Import CSV data
3. Profile and validate raw data
4. Clean and standardize the dataset
5. Validate cleaned data
6. Analyze hospital KPIs
7. Answer business questions
8. Create a reusable department KPI view
===============================================================================
*/


-- =============================================================================
-- 1. DATABASE SETUP
-- =============================================================================

CREATE DATABASE IF NOT EXISTS hospital_operations;

USE hospital_operations;


-- =============================================================================
-- 2. RAW DATA TABLE
-- =============================================================================

DROP TABLE IF EXISTS patient_flow_raw;

CREATE TABLE patient_flow_raw (
    patient_id_raw              VARCHAR(50),
    admission_date_raw          VARCHAR(30),
    admission_time_raw          VARCHAR(30),
    patient_name_raw            VARCHAR(150),
    patient_gender_raw          VARCHAR(30),
    patient_age_raw             VARCHAR(20),
    patient_race_raw            VARCHAR(100),
    department_referral_raw     VARCHAR(100),
    admission_status_raw        VARCHAR(50),
    satisfaction_score_raw      VARCHAR(20),
    wait_time_raw               VARCHAR(20)
);
